---
/**
 * Grid of Balizen symbols, rendered from the SVG artwork in
 * src/assets/icons/svgs/Illustrations (supplied by Sid, Aug 2026).
 *
 * Meanings come from the style guide's Symbols sheet and are transcribed
 * verbatim on the page — a symbol whose sheet entry carries no meaning is
 * shown as artwork only, never given an invented one.
 *
 * Hovering (or focusing) a tile reveals two download buttons: SVG serves the
 * untouched artwork file (`?url` glob), PNG a 512px raster generated at build
 * time by astro:assets.
 *
 * The page-level "download all" zip is NOT generated here — it lives at
 * public/downloads/balizen-symbols.zip. Regenerate after any SVG change:
 *   cd src/assets/icons/svgs/Illustrations && zip -X ../../../../../public/downloads/balizen-symbols.zip *.svg
 *
 * Usage:
 *   <SymbolGrid items={[{ file: 'Gingko', meanings: ['Balizen signature', 'Made with love', 'Local'] }, …]} />
 */
import { Image, getImage } from 'astro:assets';

interface Props {
	items: { file: string; meanings?: string[] }[];
}

const svgs = import.meta.glob<{ default: ImageMetadata }>(
	'../assets/icons/svgs/Illustrations/*.svg',
	{ eager: true }
);
const svgUrls = import.meta.glob<string>('../assets/icons/svgs/Illustrations/*.svg', {
	eager: true,
	// no-inline: always emit real .svg files — a data: URI download works, but
	// bloats the HTML and loses the asset URL.
	query: '?url&no-inline',
	import: 'default',
});

const { items } = Astro.props;
const resolved = await Promise.all(
	items.map(async (item) => {
		const key = `../assets/icons/svgs/Illustrations/${item.file}.svg`;
		const mod = svgs[key];
		if (!mod) {
			throw new Error(
				`SymbolGrid: "${item.file}.svg" not found in src/assets/icons/svgs/Illustrations`
			);
		}
		const png = await getImage({ src: mod.default, format: 'png', width: 512, height: 512 });
		const slug = item.file.toLowerCase().replace(/[^a-z0-9]+/g, '-');
		return { ...item, src: mod.default, svgUrl: svgUrls[key], pngUrl: png.src, slug };
	})
);
---

<div class="symbol-grid not-content">
	{
		resolved.map(({ file, meanings, src, svgUrl, pngUrl, slug }) => (
			<figure class="symbol">
				<div class="art">
					<Image src={src} alt={meanings ? meanings.join(' · ') : `${file} symbol`} width="96" height="96" />
					<span class="dls">
						<a href={svgUrl} download={`balizen-symbol-${slug}.svg`} aria-label={`Download ${file} as SVG`}>SVG</a>
						<a href={pngUrl} download={`balizen-symbol-${slug}.png`} aria-label={`Download ${file} as PNG`}>PNG</a>
					</span>
				</div>
				{meanings && (
					<figcaption>
						{meanings.map((m) => (
							<span>{m}</span>
						))}
					</figcaption>
				)}
			</figure>
		))
	}
</div>

<style>
	.symbol-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(9.5rem, 1fr));
		gap: 0.75rem;
		margin: 1.75rem 0 2.5rem;
	}

	.symbol {
		margin: 0;
		background: var(--panel);
		border-radius: 10px;
		padding: 1.1rem 0.9rem 1rem;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.75rem;
		position: relative;
	}

	.art :global(img) {
		display: block;
		width: 4.5rem;
		height: 4.5rem;
		object-fit: contain;
	}

	/* Per-symbol download buttons: hidden until the tile is hovered/focused. */
	.dls {
		position: absolute;
		top: 0.5rem;
		right: 0.5rem;
		display: flex;
		gap: 0.3rem;
	}

	.dls a {
		padding: 0.18rem 0.5rem;
		border: 1px solid var(--line);
		border-radius: 999px;
		background: var(--ui-page-bg);
		font-family: var(--font-sans);
		font-size: 0.68rem;
		font-weight: 600;
		letter-spacing: 0.04em;
		color: var(--teal-dark);
		text-decoration: none;
		opacity: 0;
		transition: opacity 0.15s;
	}

	.symbol:hover .dls a,
	.dls a:focus-visible {
		opacity: 1;
	}

	.dls a:hover {
		background: var(--teal-tint);
	}

	@media (hover: none) {
		.dls a {
			opacity: 1;
		}
	}

	figcaption {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
		text-align: center;
		font-family: var(--font-sans);
		font-size: 0.8rem;
		line-height: 1.4;
		color: var(--grey);
	}
</style>
