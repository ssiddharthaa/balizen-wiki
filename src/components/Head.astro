---
/**
 * Head override: default Starlight head + brand fonts + design tokens.
 * Design tokens are injected as CSS custom properties straight from
 * data/tokens.json — the single source for all colors (do not hardcode hexes
 * in stylesheets; reference the variables below).
 */
import Default from '@astrojs/starlight/components/Head.astro';
import tokens from '../../data/tokens.json';

const cssVars = [
	...Object.entries(tokens.ui).map(([k, v]) => `--ui-${k}: ${v};`),
	...Object.entries(tokens.brand).map(([k, v]) => `--${k}: ${v};`),
	// Prototype-compatible aliases used throughout custom.css
	`--teal: ${tokens.brand['balizen-teal']};`,
	`--hugger: ${tokens.brand['tree-hugger']};`,
	`--grey: ${tokens.brand['paynes-grey']};`,
	`--panel: ${tokens.ui.panel};`,
	`--ink: ${tokens.ui.ink};`,
	`--line: ${tokens.ui.line};`,
].join(' ');
---

<Default><slot /></Default>

{/* Free web fonts (brand-approved fallbacks): Playfair Display (Heading 1b) + Instrument Sans */}
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
	href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;1,400&family=Instrument+Sans:ital,wght@0,400;0,500;0,600;1,400&display=swap"
	rel="stylesheet"
/>

{/*
	==================================================================
	ADOBE FONTS WEB PROJECT EMBED — PLACEHOLDER
	Sid: paste the Adobe Fonts embed <link> line for the Web Project
	(Scotch Display Light + Area Inktrap Regular/ExtraBold) directly
	below this comment. Then confirm the family names in
	src/styles/custom.css (--font-serif / --font-sans) match the names
	in the kit's CSS.
	==================================================================
*/}

<style set:html={`:root{${cssVars}}`}></style>

{/*
	Glossary tooltips: tap-to-toggle on touch (CSS handles hover/focus on desktop),
	plus positioning.

	Progressive enhancement: the tooltip is absolutely positioned by CSS, which
	works everywhere except inside a clipping ancestor — and Starlight gives
	tables `overflow-x: auto` for mobile scrolling, which would clip tooltips on
	the Correct Terms Glossary (a page that is almost entirely tables). While a
	tooltip is shown, this script re-positions it as `fixed` so it escapes any
	clipping context. Without JS, hover tooltips still work outside tables.
*/}
<script is:inline>
	(() => {
		const MARGIN = 8;
		let pinned = null;

		const place = (g) => {
			const tip = g.querySelector('.tip');
			if (!tip) return;
			tip.style.position = 'fixed';
			tip.style.transform = 'none';
			tip.style.left = '0';
			tip.style.top = 'auto';
			tip.style.bottom = 'auto';
			const gr = g.getBoundingClientRect();
			// offsetWidth/offsetHeight force layout and are reliable here;
			// the bubble is anchored by `bottom` in the common case so its height
			// never has to be trusted for placement — only for the flip decision.
			const w = tip.offsetWidth;
			const h = tip.offsetHeight;
			// Centred on the term, clamped into the viewport.
			let left = gr.left + gr.width / 2 - w / 2;
			left = Math.max(MARGIN, Math.min(left, innerWidth - w - MARGIN));
			const below = gr.top - h - 10 < MARGIN; // no room above — flip below
			tip.style.left = left + 'px';
			if (below) {
				tip.style.top = gr.bottom + 10 + 'px';
			} else {
				tip.style.bottom = innerHeight - gr.top + 10 + 'px';
			}
			// Keep the arrow pointing at the term even when the bubble is clamped.
			tip.style.setProperty('--arrow-x', gr.left + gr.width / 2 - left + 'px');
			tip.classList.toggle('below', below);
		};

		const clear = (g) => {
			const tip = g.querySelector('.tip');
			if (!tip) return;
			tip.style.position = '';
			tip.style.left = '';
			tip.style.top = '';
			tip.style.bottom = '';
			tip.style.transform = '';
			tip.style.removeProperty('--arrow-x');
			tip.classList.remove('below');
		};

		const unpin = () => {
			if (!pinned) return;
			pinned.classList.remove('tap');
			clear(pinned);
			pinned = null;
		};

		document.addEventListener('pointerover', (e) => {
			const g = e.target.closest?.('.g');
			if (g && g !== pinned) place(g);
		});
		document.addEventListener('pointerout', (e) => {
			const g = e.target.closest?.('.g');
			if (g && g !== pinned && !g.contains(e.relatedTarget)) clear(g);
		});
		document.addEventListener('focusin', (e) => {
			const g = e.target.closest?.('.g');
			if (g) place(g);
		});
		document.addEventListener('focusout', (e) => {
			const g = e.target.closest?.('.g');
			if (g && g !== pinned) clear(g);
		});

		// Tap to toggle on touch.
		document.addEventListener('click', (e) => {
			if (e.target.closest('.g .tip a')) return; // let tooltip links navigate
			const g = e.target.closest('.g');
			if (pinned && pinned !== g) unpin();
			if (!g) return;
			if (g === pinned) {
				unpin();
			} else {
				pinned = g;
				g.classList.add('tap');
				place(g);
			}
		});

		addEventListener('scroll', () => pinned && place(pinned), { passive: true });
		addEventListener('resize', () => pinned && place(pinned));
		addEventListener('keydown', (e) => e.key === 'Escape' && unpin());
	})();
</script>

{/*
	Sidebar behaviour (Sid, 16 Aug 2026).

	Mobile — Starlight's menu button already toggles [data-mobile-menu-expanded]
	on <body> and marks .main-frame inert, so custom.css does the drawer purely
	from that attribute. This adds the tappable backdrop, and closes the drawer
	on navigation so the slide-out is visible rather than cut off by the load.

	Desktop — a collapse toggle, open by default, choice persisted. The attribute
	is applied here in <head> so a collapsed sidebar never flashes open first.
*/}
<script is:inline>
	(() => {
		const DESKTOP = '(min-width: 50rem)';
		const KEY = 'balizen:sidebar-collapsed';

		// Pre-paint: restore a collapsed sidebar before the first frame.
		try {
			if (localStorage.getItem(KEY) === '1') {
				document.documentElement.setAttribute('data-sidebar-collapsed', '');
			}
		} catch {}

		const ready = (fn) =>
			document.readyState === 'loading'
				? document.addEventListener('DOMContentLoaded', fn, { once: true })
				: fn();

		ready(() => {
			const menuButton = document.querySelector('starlight-menu-button button');

			// --- Mobile backdrop -------------------------------------------------
			const backdrop = document.createElement('div');
			backdrop.className = 'sl-backdrop';
			backdrop.setAttribute('aria-hidden', 'true');
			// Route the close through Starlight's own button so its aria-expanded
			// and inert bookkeeping stay correct.
			backdrop.addEventListener('click', () => menuButton && menuButton.click());
			document.body.appendChild(backdrop);

			// Close the drawer on navigation. The click is deferred by one
			// animation so the panel is seen sliding away instead of vanishing
			// with the page swap.
			document.addEventListener('click', (e) => {
				if (!document.body.hasAttribute('data-mobile-menu-expanded')) return;
				const link = e.target.closest('.sidebar-content a[href]');
				if (!link || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;
				if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
				e.preventDefault();
				if (menuButton) menuButton.click();
				setTimeout(() => {
					location.href = link.href;
				}, 260);
			});

			// --- Desktop collapse toggle ----------------------------------------
			const toggle = document.createElement('button');
			toggle.type = 'button';
			toggle.className = 'sidebar-toggle';
			toggle.innerHTML =
				'<svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true">' +
				'<path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" ' +
				'stroke-linejoin="round" d="M10 3 5 8l5 5"/></svg>';

			const syncLabel = () => {
				const collapsed = document.documentElement.hasAttribute('data-sidebar-collapsed');
				toggle.setAttribute('aria-expanded', String(!collapsed));
				toggle.setAttribute('aria-label', collapsed ? 'Show sidebar' : 'Hide sidebar');
			};

			toggle.addEventListener('click', () => {
				const collapsed = document.documentElement.toggleAttribute('data-sidebar-collapsed');
				try {
					localStorage.setItem(KEY, collapsed ? '1' : '0');
				} catch {}
				syncLabel();
			});

			syncLabel();
			toggle.setAttribute('aria-controls', 'starlight__sidebar');
			document.body.appendChild(toggle);

			// Leaving desktop clears the collapse so the mobile drawer is reachable.
			matchMedia(DESKTOP).addEventListener('change', (e) => {
				if (!e.matches) document.documentElement.removeAttribute('data-sidebar-collapsed');
				else if (localStorage.getItem(KEY) === '1')
					document.documentElement.setAttribute('data-sidebar-collapsed', '');
				syncLabel();
			});
		});
	})();
</script>

{/*
	Lightbox: click any content image to see it enlarged (Sid, 15 Aug 2026).
	Applies to images in the page body — the logo-file and symbol tiles are
	excluded, since hovering those reveals download buttons instead. The
	overlay is built once on demand; click anywhere or Esc closes. PhotoSet's
	callout label (or the image's alt) becomes the caption.
*/}
<script is:inline>
	(() => {
		let overlay = null;
		let lastFocus = null;

		const close = () => {
			if (!overlay) return;
			overlay.classList.remove('open');
			document.documentElement.classList.remove('lb-lock');
			if (lastFocus && lastFocus.focus) lastFocus.focus();
		};

		const build = () => {
			overlay = document.createElement('div');
			overlay.className = 'lightbox';
			overlay.setAttribute('role', 'dialog');
			overlay.setAttribute('aria-modal', 'true');
			overlay.setAttribute('aria-label', 'Enlarged image');
			overlay.tabIndex = -1;
			overlay.innerHTML =
				'<figure><img alt="" /><figcaption class="lb-caption"></figcaption></figure>' +
				'<button type="button" class="lb-close" aria-label="Close">×</button>';
			overlay.addEventListener('click', close);
			document.body.appendChild(overlay);
		};

		const open = (img) => {
			if (!overlay) build();
			const big = overlay.querySelector('img');
			big.src = img.currentSrc || img.src;
			big.alt = img.alt || '';
			const label = img.closest('.photo-set')?.querySelector('.callout')?.textContent;
			const caption = overlay.querySelector('.lb-caption');
			caption.textContent = label || img.alt || '';
			caption.hidden = !caption.textContent;
			lastFocus = document.activeElement;
			overlay.classList.add('open');
			document.documentElement.classList.add('lb-lock');
			overlay.focus();
		};

		document.addEventListener('click', (e) => {
			const img = e.target.closest?.('.sl-markdown-content img');
			if (!img) return;
			if (img.closest('.logo-files') || img.closest('.symbol-grid')) return;
			if (img.closest('a')) return; // linked images keep their link behaviour
			open(img);
		});

		addEventListener('keydown', (e) => {
			if (e.key === 'Escape' && overlay && overlay.classList.contains('open')) close();
		});
	})();
</script>

{/*
	Heading anchors: Starlight's per-heading link exists to hand you a URL for
	that section, but clicking it only appears to jump to where you already are
	— the useful part (a shareable deep link) is invisible. So clicking also
	copies the absolute URL and says so. The link still works normally: the
	hash lands in the address bar either way, and ⌘/ctrl/middle-click, or a
	failed copy, fall through to plain navigation.
*/}
<script is:inline>
	(() => {
		const legacyCopy = (text) => {
			const ta = document.createElement('textarea');
			ta.value = text;
			ta.style.position = 'fixed';
			ta.style.opacity = '0';
			document.body.appendChild(ta);
			ta.select();
			let ok = false;
			try {
				ok = document.execCommand('copy');
			} catch {}
			ta.remove();
			return ok;
		};

		let toast = null;
		const flash = (anchor) => {
			if (!toast) {
				toast = document.createElement('span');
				toast.className = 'anchor-toast';
				document.body.appendChild(toast);
			}
			const r = anchor.getBoundingClientRect();
			toast.textContent = 'Link copied';
			toast.style.left = r.left + r.width / 2 + 'px';
			toast.style.top = r.top - 8 + 'px';
			toast.classList.add('show');
			clearTimeout(toast._t);
			toast._t = setTimeout(() => toast.classList.remove('show'), 1400);
		};

		document.addEventListener('click', async (e) => {
			if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;
			const a = e.target.closest?.('.sl-anchor-link');
			if (!a) return;
			const url = new URL(a.getAttribute('href'), location.href).href;
			let ok = false;
			try {
				await navigator.clipboard.writeText(url);
				ok = true;
			} catch {
				ok = legacyCopy(url);
			}
			if (ok) {
				e.preventDefault();
				history.replaceState(null, '', a.getAttribute('href')); // keep the hash in the bar
				flash(a);
			}
		});
	})();
</script>
