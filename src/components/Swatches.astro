---
/**
 * Live color swatches, rendered from data/tokens.json — the single source for
 * all colors. Pass token keys from tokens.brand; name/note text comes from the
 * page (transcribed from the source document).
 *
 * Usage:
 *   <Swatches items={[{ token: 'balizen-teal', name: 'Balizen Teal', note: 'Primary' }, …]} />
 */
import tokens from '../../data/tokens.json';

interface Props {
	items: { token: keyof typeof tokens.brand; name: string; note?: string }[];
}

const { items } = Astro.props;
const resolved = items.map((item) => {
	const hex = tokens.brand[item.token];
	if (!hex) throw new Error(`Swatches: token "${item.token}" not found in data/tokens.json`);
	return { ...item, hex };
});
---

{/* `not-content` opts out of Starlight's markdown sibling spacing, which would
    otherwise add margin-top to every card after the first and break the grid. */}
<div class="swatches not-content">
	{
		resolved.map(({ name, hex, note }) => (
			<div class="sw">
				<div class="chip" style={`background:${hex}`}>
					<button type="button" class="copy" data-hex={hex} aria-label={`Copy ${hex}`}>
						Copy
					</button>
				</div>
				<div class="meta">
					<b>{name}</b>
					<code>{hex}</code>
					{note && <span class="use">{note}</span>}
				</div>
			</div>
		))
	}
</div>

<script>
	// Copy-hex buttons: click copies the swatch's hex, label confirms briefly.
	const legacyCopy = (text: string) => {
		const ta = document.createElement('textarea');
		ta.value = text;
		ta.style.position = 'fixed';
		ta.style.opacity = '0';
		document.body.appendChild(ta);
		ta.select();
		const ok = document.execCommand('copy');
		ta.remove();
		return ok;
	};

	document.addEventListener('click', async (e) => {
		const btn = (e.target as HTMLElement).closest?.('.sw .copy') as HTMLButtonElement | null;
		if (!btn || !btn.dataset.hex) return;
		let ok = false;
		try {
			await navigator.clipboard.writeText(btn.dataset.hex);
			ok = true;
		} catch {
			ok = legacyCopy(btn.dataset.hex);
		}
		btn.textContent = ok ? 'Copied ✓' : btn.dataset.hex;
		btn.classList.toggle('done', ok);
		setTimeout(() => {
			btn.textContent = 'Copy';
			btn.classList.remove('done');
		}, 1400);
	});
</script>
